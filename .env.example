# Default network preselected when creating a community: 0 = preprod, 1 = mainnet.
# Each community picks its own network at creation; this is only the default.
NEXT_PUBLIC_NETWORK=0

# Koios. One API key works on both networks (strongly recommended, the
# anonymous tier is tightly rate-limited: https://koios.rest). The base URLs
# are optional per-network overrides for a mirror; empty = the public hosts.
KOIOS_API_KEY=
KOIOS_BASE_URL_MAINNET=
KOIOS_BASE_URL_PREPROD=

# Supabase. Day to day this block points at the LOCAL stack: copy the values
# from `supabase status -o env` by hand (mapping in scripts/README.md).
# Keep the remote project's values in .env.remote (gitignored, yours to
# load manually when running against the remote). For the remote project:
# URL + anon + service-role key from Project Settings -> API, and the legacy
# JWT secret (must be enabled on new projects).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Local tooling only (never read by the app): the local database URL from
# `supabase status -o env`. A remote direct/session-pooler connection string
# (Project Settings -> Database) may live in .env.remote for manual
# pg_dump/psql use; `npm run db:snapshot` uses the linked project instead.
SUPABASE_DB_URL=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Multi-line PEM: replace newlines with \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# "Identifying users" OAuth credentials from the same GitHub App settings page
# (callback URL: $APP_URL/api/github/oauth-callback). Used for the one-off
# GitHub-account <-> wallet link.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Account linking for call attendance (Profile page). Discord: an application's
# OAuth2 client, redirect $APP_URL/api/discord/oauth-callback, scope `identify`.
# Google: an OAuth web client, redirect $APP_URL/api/google/oauth-callback,
# scope `openid` only (non-sensitive; publish the consent screen so any user
# can link). Meet capture uses the same client: also register the redirect
# $APP_URL/api/google/host-callback, enable the "Google Meet REST API" in the
# project and add the scope .../auth/meetings.space.readonly (sensitive: hosts
# see an "unverified app" notice until Google verifies the app).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The same application's bot token (Bot tab). Call capture reads who is in a
# voice channel with it; no privileged intents. Also register the redirect
# $APP_URL/api/discord/guild-callback (adding the bot to a community's server).
DISCORD_BOT_TOKEN=
# Zoom call capture: a General (OAuth, user-managed) app on marketplace.zoom.us.
# Redirect $APP_URL/api/zoom/oauth-callback; event subscription endpoint
# $APP_URL/api/zoom/webhook with Participant joined / left and Meeting ended
# (the end of a linked meeting's call); scopes to read the user and past
# meeting participants. The webhook Secret Token signs events.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret for /api/cron/* triggers
CRON_SECRET=
# Signs every OAuth / install state. Optional (falls back to a key derived from
# CRON_SECRET), but set a separate random value so one leak cannot forge both.
OAUTH_STATE_SECRET=
# Signs the access tokens AI assistants get from the agent API (/api/mcp,
# /api/v1). REQUIRED in production; locally it falls back to a key derived
# from CRON_SECRET. A separate random value; never reuse SUPABASE_JWT_SECRET.
MCP_TOKEN_SECRET=
# Encrypts the app-held co-signer key of each co-signer treasury (AES-256-GCM).
# REQUIRED in production; locally it falls back to a key derived from
# CRON_SECRET. A separate random value. Back it up: without it those keys are
# unusable and only the bypass path (every base signer) moves the funds.
COSIGNER_KEY_SECRET=

# Wallets that can open the internal /dev tools page (Discord message tester
# etc.): comma-separated payment addresses. Empty = the page is off for everyone.
DEV_WALLETS=

# Public base URL of the app, no trailing slash. Production is
# https://app.treasuryguild.com. Local development stays on localhost.
APP_URL=http://localhost:3000

# Pinata (IPFS pinning for token images — free plan: https://app.pinata.cloud)
# API key JWT with "Files: write" scope. Server-only: it mints short-lived
# presigned upload URLs; the browser uploads straight to Pinata.
PINATA_JWT=
# Your gateway host (Dashboard -> Gateways), e.g. fun-llama-300.mypinata.cloud.
# Falls back to the public gateway.pinata.cloud when empty.
PINATA_GATEWAY=

