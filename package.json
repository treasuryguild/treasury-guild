{
  "name": "treasury-guild",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:migrate": "supabase migration up --local",
    "db:snapshot": "supabase db dump --linked --data-only -s public -x public.auth_nonces,public.webhook_events,public.call_integration_secrets,public.treasury_cosigner_keys,public.treasury_discord_destinations,public.oauth_grants,public.oauth_clients,public.oauth_authorization_codes,public.oauth_refresh_tokens,public.community_invites,public.rate_limits,public.call_checkin_codes -f supabase/seeds/local/remote_snapshot.sql",
    "db:status": "supabase status",
    "seed:sandbox": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -X -v ON_ERROR_STOP=1 -f supabase/seeds/signius_sandbox.sql",
    "seed:live": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -X -v ON_ERROR_STOP=1 -f supabase/seeds/signius_live.sql"
  },
  "overrides": {
    "@utxos/sdk": {
      "@meshsdk/core-cst": "$@meshsdk/core-cst",
      "@meshsdk/transaction": "1.9.1",
      "@meshsdk/wallet": "1.9.1"
    },
    "jsdom": {
      "undici": "^7.25.0"
    },
    "ip-address": "^10.7.0",
    "undici": "^6.23.0"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@meshsdk/common": "^1.9.0",
    "@meshsdk/core": "^1.9.0",
    "@meshsdk/core-csl": "^1.9.0",
    "@meshsdk/core-cst": "^1.9.0",
    "@meshsdk/provider": "^1.9.0-beta.101",
    "@meshsdk/react": "^2.0.0-beta.2",
    "@modelcontextprotocol/server": "^2.1.0",
    "@next/mdx": "^16.3.4",
    "@octokit/webhooks-methods": "^6.0.0",
    "@supabase/supabase-js": "^2.112.4",
    "jose": "^6.2.10",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "octokit": "^5.0.5",
    "pinata": "^2.5.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "undici": "^6.29.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
